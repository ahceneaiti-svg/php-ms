{
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-apcu": "*",
        "ext-pcntl": "*",
        "monolog/monolog": "^3.5",
        "nyholm/psr7": "^1.8",
        "open-telemetry/api": "^1.0",
        "open-telemetry/exporter-otlp": "^1.0",
        "open-telemetry/sdk": "^1.0",
        "open-telemetry/sem-conv": "^1.24",
        "php-amqplib/php-amqplib": "^3.5",
        "php-http/discovery": "^1.19",
        "promphp/prometheus_client_php": "^2.10",
        "symfony/console": "^7.2",
        "symfony/dotenv": "^7.2",
        "symfony/framework-bundle": "^7.2",
        "symfony/http-client": "^7.2",
        "symfony/mailer": "^7.2",
        "symfony/monolog-bundle": "^3.10",
        "symfony/psr-http-message-bridge": "^7.2",
        "symfony/yaml": "^7.2"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.3.33"
        },
        "platform-check": false
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    }
}
